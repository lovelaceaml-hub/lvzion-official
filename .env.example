# Never commit live values. The prototype and fictional preview need no secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Live member APIs are OFF until an isolated environment is deliberately reviewed.
LVZ_MEMBER_SYSTEM_ENABLED=false
LVZ_DATABASE_ENV=isolated
LVZ_SUPABASE_EXPECTED_REF=
LVZ_APP_ORIGIN=
# Server-only; never add NEXT_PUBLIC_ to these keys.
SUPABASE_SECRET_KEY=
LVZ_RATE_LIMIT_SECRET=
# Remains off: no emails are sent by the fictional preview.
LVZ_EMAIL_DELIVERY_ENABLED=false
