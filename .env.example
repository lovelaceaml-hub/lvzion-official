# Public client configuration. Never commit actual credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Hosted member access remains disabled until designated test sign-in is verified.
LVZ_MEMBER_SYSTEM_ENABLED=false
LVZ_DATABASE_ENV=isolated
LVZ_SUPABASE_EXPECTED_REF=
LVZ_APP_ORIGIN=
# Server-only identity and cryptographic keys; never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
LVZ_RATE_LIMIT_SECRET=
# Hosted mail requires an approved provider and explicit test-recipient allowlist.
LVZ_EMAIL_DELIVERY_ENABLED=false
LVZ_SMTP_HOST=
LVZ_SMTP_PORT=587
LVZ_SMTP_FROM=
LVZ_SMTP_USER=
LVZ_SMTP_PASSWORD=
LVZ_TEST_EMAIL_ALLOWLIST=
# Local integration flag must never be enabled on a hosted deployment.
LVZ_LOCAL_INTEGRATION=false

# Self-service signup remains disabled in BOTH application and database.
LVZ_SELF_SERVICE_SIGNUP_ENABLED=false
LVZ_SIGNUP_DELIVERY_VERIFIED=false
LVZ_SIGNUP_CAPTCHA_VERIFIED=false
NEXT_PUBLIC_LVZ_HCAPTCHA_SITE_KEY=
# Review Supabase SMTP, confirmation templates, CAPTCHA and redirect allowlist
# against the isolated test project before these verification flags are enabled.
